[[inputs.snmp]]
  agents = [
{% for device in monitoring_devices if "-R" in device.key or device.value.role == "WAN Edge" %}
    "udp://{{ device.value.address }}:161"{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
  version = 3
  sec_name = "prtgadmin"
  auth_protocol = "SHA"
  auth_password = "{{ snmp_auth_password }}"
  sec_level = "authNoPriv"
  timeout = "5s"
  retries = 2
  name = "cisco"

  [[inputs.snmp.field]]
    name = "sysName"
    oid = "SNMPv2-MIB::sysName.0"

  [[inputs.snmp.field]]
    name = "sysDescr"
    oid = "SNMPv2-MIB::sysDescr.0"

  [[inputs.snmp.field]]
    name = "sysUpTime"
    oid = "SNMPv2-MIB::sysUpTime.0"

  [[inputs.snmp.field]]
    name = "sysLocation"
    oid = "SNMPv2-MIB::sysLocation.0"

  [[inputs.snmp.field]]
    name = "sysContact"
    oid = "SNMPv2-MIB::sysContact.0"
   
  [[inputs.snmp.field]]
    name = "cpu_5min"
    oid = "1.3.6.1.4.1.9.9.109.1.1.1.1.5.1"

  [[inputs.snmp.table]]
    name = "interface"
    oid = "IF-MIB::ifTable"
    inherit_tags = ["sysName"]

  [[inputs.snmp.table.field]]
    name = "ifName"
    oid = "IF-MIB::ifName"
    is_tag = true

  [[inputs.snmp.table.field]]
    name = "ifOperStatus"
    oid = "IF-MIB::ifOperStatus"
	
  [[inputs.snmp.table.field]]
    name = "ifHCInOctets"
    oid = "IF-MIB::ifHCInOctets"
	
  [[inputs.snmp.table.field]]
    name = "ifHCOutOctets"
    oid = "IF-MIB::ifHCOutOctets"
    
  [[inputs.snmp.table.field]]
      name = "ifInErrors"
      oid = "IF-MIB::ifInErrors"

  [[inputs.snmp.table.field]]
    name = "ifOutErrors"
    oid = "IF-MIB::ifOutErrors"
  
  [[inputs.snmp.table.field]]
    name = "ifInDiscards"
    oid = "IF-MIB::ifInDiscards"
  
  [[inputs.snmp.table.field]]
    name = "ifOutDiscards"
    oid = "IF-MIB::ifOutDiscards"
    
  [[inputs.snmp.field]]
    name = "slaState"
    oid = "1.3.6.1.4.1.9.9.42.1.2.10.1.2.1"
    is_tag = false
   
  [[inputs.snmp.table]]
    name = "hsrp"
    index_as_tag = true

  [[inputs.snmp.table.field]]
    name = "hsrp_priority"
    oid = "1.3.6.1.4.1.9.9.106.1.2.1.1.3"

  [[inputs.snmp.table.field]]
    name = "hsrp_preempt"
    oid = "1.3.6.1.4.1.9.9.106.1.2.1.1.4"

  [[inputs.snmp.table.field]]
    name = "hsrp_virtual_ip"
    oid = "1.3.6.1.4.1.9.9.106.1.2.1.1.11"

  [[inputs.snmp.table.field]]
    name = "hsrp_active_router"
    oid = "1.3.6.1.4.1.9.9.106.1.2.1.1.13"

  [[inputs.snmp.table.field]]
    name = "hsrp_standby_router"
    oid = "1.3.6.1.4.1.9.9.106.1.2.1.1.14"

  [[inputs.snmp.table.field]]
    name = "hsrp_state"
    oid = "1.3.6.1.4.1.9.9.106.1.2.1.1.15"

  [[inputs.snmp.table.field]]
    name = "hsrp_virtual_mac"
    oid = "1.3.6.1.4.1.9.9.106.1.2.1.1.16"
    conversion = "hwaddr"
  
  [[inputs.snmp.table]]
  	name = "ospf_neighbor"
  	index_as_tag = true

  [[inputs.snmp.table.field]]
    name = "ospf_neighbor_ip"
    oid = "1.3.6.1.2.1.14.10.1.1"
    is_tag = true

  [[inputs.snmp.table.field]]
    name = "ospf_neighbor_router_id"
    oid = "1.3.6.1.2.1.14.10.1.3"
    is_tag = true

  [[inputs.snmp.table.field]]
    name = "ospf_neighbor_state"
    oid = "1.3.6.1.2.1.14.10.1.6"

  [[inputs.snmp.table.field]]
    name = "ospf_neighbor_state_changes"
    oid = "1.3.6.1.2.1.14.10.1.10"
    
  [[inputs.ping]]
  	urls = [
{% for device in monitoring_devices if "-R" in device.key or device.value.role == "WAN Edge" %}
    "{{ device.value.address }}"{% if not loop.last %},{% endif %}
    {% endfor %}
  	]
    count = 2
    ping_interval = 1.0
    timeout = 2.0
    
